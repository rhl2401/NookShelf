# Also used by docker-compose.yml to set up the Postgres container itself —
# generate a strong value, e.g. `openssl rand -hex 24`. Use hex, not base64:
# DATABASE_URL below embeds this value directly with no URL-encoding, and
# base64 can produce '/', '+', or '=', any of which corrupts the connection
# string (Docker Compose's own docker-compose.yml doesn't have this problem —
# docker-entrypoint.sh URL-encodes it there).
POSTGRES_PASSWORD="generate-with-openssl-rand-hex-24"
DATABASE_URL="postgresql://assetmgmt:$POSTGRES_PASSWORD@localhost:5432/assetmgmt?schema=public"

NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Set to "true" if you're running behind your own reverse proxy (nginx, Caddy,
# Traefik, etc.) with a real domain — otherwise sign-in fails with Auth.js's
# "UntrustedHost" error, since it only auto-trusts the host on Vercel/Cloudflare
# Pages. Leave "false" if the app is exposed directly with no reverse proxy.
AUTH_TRUST_HOST=false

# Dev-only bypass login (pick/create a test user without any OAuth app).
# Only takes effect under `next dev` — the Docker image always runs with
# NODE_ENV=production, where this is structurally disabled regardless.
# NEVER set this in a real deployment.
AUTH_DEV_LOGIN=false

# OAuth providers — leave blank to disable a provider on the login screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

AUTH_GENERIC_OIDC_ID=
AUTH_GENERIC_OIDC_SECRET=
AUTH_GENERIC_OIDC_ISSUER=
AUTH_GENERIC_OIDC_NAME="Single Sign-On"

# Email (optional — leave SMTP_HOST blank to disable email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NookShelf <noreply@example.com>"

UPLOADS_DIR="./uploads"

# File storage backend: "local" (default, writes under UPLOADS_DIR) or "s3".
# Leave unset/"local" unless you specifically want object storage.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
# Optional — omit to use the default AWS credential chain (e.g. an IAM role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional — set for S3-compatible providers (MinIO, Cloudflare R2, Backblaze B2, etc.).
S3_ENDPOINT=
# Optional — some S3-compatible providers (e.g. MinIO) need path-style requests.
S3_FORCE_PATH_STYLE=false
# Optional — key prefix within the bucket, if you're sharing it with other apps.
S3_PREFIX=

# The currency purchase prices are converted to and displayed in by default.
# Individual assets can still be entered in whatever currency they were
# actually bought in.
DEFAULT_CURRENCY="EUR"
